+// React Native aborts the whole app (LOG(FATAL) in convertJSIFunctionToCallback)
+// when a callback is invoked a second time. Cancel can be reported twice
+// (didCancel + presentationControllerDidDismiss, or a second cancel tap while
+// the dismiss animation runs), so every reply goes through here: take the
+// callback, clear it, invoke it once. Later replies for the same launch are dropped.
+- (void)sendResult:(NSArray *)result
+{
+    RCTResponseSenderBlock cb = nil;
+    @synchronized (self) {
+        cb = self.callback;
+        self.callback = nil;
+    }
+    if (cb != nil) {
+        cb(result);
+    }
+}
