# Resolve react_native_pods.rb with node to allow for hoisting
require Pod::Executable.execute_command('node', ['-p',
  'require.resolve(
    "react-native/scripts/react_native_pods.rb",
    {paths: [process.argv[1]]},
  )', __dir__]).strip

platform :ios, min_ios_version_supported
prepare_react_native_project!

linkage = ENV['USE_FRAMEWORKS']
if linkage != nil
  Pod::UI.puts "Configuring Pod with #{linkage}ally linked Frameworks".green
  use_frameworks! :linkage => linkage.to_sym
end

target 'bloxfruitevalues' do
  config = use_native_modules!
  use_frameworks! :linkage => :static
  $RNFirebaseAsStaticFramework = true
  $RNFirebaseAnalyticsWithoutAdIdSupport = true
  # Pin the Firebase iOS SDK ahead of what React Native Firebase defaults to.
  # RNFB 23.8.8 resolves 12.10.0, and even the current RNFB (26.4.0) only ships
  # 12.18.0 - both predate the fix we need, so upgrading RNFB does NOT get it.
  #
  # Firebase iOS 12.19.0 (#16498): "Fixed an issue on iOS 15+ where users were
  # randomly logged out during prewarming while the device was locked."
  # That is the "logged out for no reason" report. iOS prewarms the app process
  # before the user taps the icon, often while locked; the keychain is then
  # unreadable, Auth cannot restore the session and reports a null user.
  # Crashlytics 98edaf64: auth_signed_out reason=native-null, 256 events /
  # 100 users a week, with msSinceLaunch around 100ms - a prewarmed launch,
  # not a user-initiated one. Every affected device was iOS 26.2-27.0 and this
  # target is iOS 15.1, so the whole population is in scope.
  #
  # This mirrors the Android BoM 34.18.0 pin in android/build.gradle, which
  # fixed the equivalent persistence bug there. iOS never got that treatment
  # because the Android fix was a Gradle pin.
  # 12.19.0 exactly: 12.19.1 and 12.19.2 exist on GitHub but were never
  # published to the CocoaPods trunk, so pinning them fails to resolve
  # (CocoaPods misreports this as a deployment-target problem). 12.19.0
  # is the release that carries the fix, and it targets iOS 15.0.
  $FirebaseSDKVersion = '12.19.0'

  # ── AdMob bidding adapters ────────────────────────────────────────────────
  # iOS ONLY for now. The matching Android adapters were removed on 2026-09-16
  # because play-services-ads 25.4.0 is compiled with Kotlin 2.3 and this
  # project is on 2.1.20 — see the long note in android/app/build.gradle. That
  # is an Android-toolchain problem; CocoaPods has no equivalent constraint, so
  # these stay and iOS keeps serving Meta/Unity bidding. Re-add the Android
  # side after the React Native 0.87 upgrade. Meta Audience
  # Network and Unity Ads are signed as bidding sources in the AdMob console,
  # but they cannot serve on iOS until their adapters ship in the binary.
  # Left unpinned so CocoaPods resolves versions compatible with the
  # Google-Mobile-Ads-SDK that RNGoogleMobileAds.podspec pins (13.1.0). If
  # resolution fails on the SDK version, set $RNGoogleMobileAdsSDKVersion
  # above this block rather than pinning the adapters by hand.
  pod 'GoogleMobileAdsMediationFacebook'
  pod 'GoogleMobileAdsMediationUnity'

  use_react_native!(
    :path => config[:reactNativePath],
    # An absolute path to your application root.
    :app_path => "#{Pod::Config.instance.installation_root}/.."
  )

  post_install do |installer|
    # https://github.com/facebook/react-native/blob/main/packages/react-native/scripts/react_native_pods.rb#L197-L202
    react_native_post_install(
      installer,
      config[:reactNativePath],
      :mac_catalyst_enabled => false,
      # :ccache_enabled => true
    )

    # Fix: Ensure all pods use at least iOS 15.1 deployment target
    # to match the main project and avoid module compatibility errors
    installer.pods_project.targets.each do |target|
      target.build_configurations.each do |config|
        config.build_settings['CLANG_ALLOW_NON_MODULAR_INCLUDES_IN_FRAMEWORK_MODULES'] = 'YES'
        if config.build_settings['IPHONEOS_DEPLOYMENT_TARGET'].to_f < 15.1
          config.build_settings['IPHONEOS_DEPLOYMENT_TARGET'] = '15.1'
        end
      end
    end
  end
end
