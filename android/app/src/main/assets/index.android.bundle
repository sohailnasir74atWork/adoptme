{a}`);return yield(0,r(d[5]).update)(t,{admin:!1}),s.Alert.alert('Success','Admin privileges removed.'),!0}catch(a){return console.error('Error removing admin:',a),s.Alert.alert('Error','Failed to remove admin privileges.'),!1}});return function(n){return a.apply(this,arguments)}})(),e.makeAdmin=(function(){var a=(0,t.default)(function*(a){if(!a)return s.Alert.alert('Error','Invalid user ID.'),!1;try{var n=(0,r(d[5]).getDatabase)(),t=(0,r(d[5]).ref)(n,`users/${a}`);return yield(0,r(d[5]).update)(t,{admin:!0}),s.Alert.alert('Success','User is now an admin.'),!0}catch(a){return console.error('Error making admin:',a),s.Alert.alert('Error','Failed to make user an admin.'),!1}});return function(n){return a.apply(this,arguments)}})(),e.makeOwner=(function(){var a=(0,t.default)(function*(a){if(!a)return s.Alert.alert('Error','Invalid user ID.'),!1;try{var n=(0,r(d[5]).getDatabase)(),t=(0,r(d[5]).ref)(n,`users/${a}`);return yield(0,r(d[5]).update)(t,{owner:!0}),s.Alert.alert('Success','User is now an owner.'),!0}catch(a){return console.error('Error making owner:',a),s.Alert.alert('Error','Failed to make user an owner.'),!1}});return function(n){return a.apply(this,arguments)}})(),e.rulesen=["Always communicate respectfully. Hate speech, discrimination, and harassment are strictly prohibited.","Avoid sharing offensive, explicit, or inappropriate content, including text, images, or links.","Do not share personal, sensitive, or confidential information such as phone numbers, addresses, or financial details.","Spamming, repetitive messaging, or promoting products/services without permission is not allowed.","If you encounter inappropriate behavior, use the report or block tools available in the app.","Use appropriate language in the chat. Avoid abusive or overly aggressive tones.","Discussions or activities promoting illegal or unethical behavior are prohibited.","Users are responsible for the content they share and must adhere to community guidelines.","Moderators reserve the right to monitor and take action on any violations, including warnings or bans.","Content should be suitable for all approved age groups, adhering to app age requirements.","Do not share links to harmful sites, malware, or malicious content.","By using the chat feature, you agree to the app\u2019s Terms of Service and Privacy Policy.https://bloxfruitscalc.com/privacy-policy/"],e.rulesde=["Kommunizieren Sie immer respektvoll. Hassreden, Diskriminierung und Bel\xe4stigung sind streng verboten.","Vermeiden Sie das Teilen von anst\xf6\xdfigen, expliziten oder unangemessenen Inhalten, einschlie\xdflich Text, Bildern oder Links.","Geben Sie keine pers\xf6nlichen, sensiblen oder vertraulichen Informationen wie Telefonnummern, Adressen oder Finanzdaten weiter.","Spam, wiederholte Nachrichten oder das Bewerben von Produkten/Dienstleistungen ohne Erlaubnis sind nicht erlaubt.","Wenn Sie unangemessenes Verhalten bemerken, nutzen Sie die Melde- oder Blockierfunktion der App.","Verwenden Sie eine angemessene Sprache im Chat. Vermeiden Sie beleidigende oder aggressive T\xf6ne.","Diskussionen oder Aktivit\xe4ten, die illegales oder unethisches Verhalten f\xf6rdern, sind verboten.","Benutzer sind f\xfcr die Inhalte verantwortlich, die sie teilen, und m\xfcssen sich an die Community-Richtlinien halten.","Moderatoren behalten sich das Recht vor, Verst\xf6\xdfe zu \xfcberwachen und Ma\xdfnahmen zu ergreifen, einschlie\xdflich Verwarnungen oder Sperren.","Inhalte sollten f\xfcr alle genehmigten Altersgruppen geeignet sein und den Altersanforderungen der App entsprechen.","Teilen Sie keine Links zu sch\xe4dlichen Websites, Malware oder b\xf6sartigen Inhalten.","Durch die Nutzung der Chat-Funktion stimmen Sie den Nutzungsbedingungen und der Datenschutzrichtlinie der App zu. https://bloxfruitscalc.com/privacy-policy/"],e.rulesvi=["Lu\xf4n giao ti\u1ebfp m\u1ed9t c\xe1ch t\xf4n tr\u1ecdng. Ph\xe1t ng\xf4n th\xf9 \u0111\u1ecbch, ph\xe2n bi\u1ec7t \u0111\u1ed1i x\u1eed v\xe0 qu\u1ea5y r\u1ed1i \u0111\u1ec1u b\u1ecb nghi\xeam c\u1ea5m.","Tr\xe1nh chia s\u1ebb n\u1ed9i dung ph\u1ea3n c\u1ea3m, r\xf5 r\xe0ng ho\u1eb7c kh\xf4ng ph\xf9 h\u1ee3p, bao g\u1ed3m v\u0103n b\u1ea3n, h\xecnh \u1ea3nh ho\u1eb7c li\xean k\u1ebft.","Kh\xf4ng chia s\u1ebb th\xf4ng tin c\xe1 nh\xe2n, nh\u1ea1y c\u1ea3m ho\u1eb7c b\u1ea3o m\u1eadt nh\u01b0 s\u1ed1 \u0111i\u1ec7n tho\u1ea1i, \u0111\u1ecba ch\u1ec9 ho\u1eb7c d\u1eef li\u1ec7u t\xe0i ch\xednh.","Kh\xf4ng spam, g\u1eedi tin nh\u1eafn l\u1eb7p l\u1ea1i ho\u1eb7c qu\u1ea3ng b\xe1 s\u1ea3n ph\u1ea9m/d\u1ecbch v\u1ee5 m\xe0 kh\xf4ng \u0111\u01b0\u1ee3c ph\xe9p.","N\u1ebfu b\u1ea1n g\u1eb7p h\xe0nh vi kh\xf4ng ph\xf9 h\u1ee3p, h\xe3y s\u1eed d\u1ee5ng c\xf4ng c\u1ee5 b\xe1o c\xe1o ho\u1eb7c ch\u1eb7n c\xf3 trong \u1ee9ng d\u1ee5ng.","S\u1eed d\u1ee5ng ng\xf4n ng\u1eef ph\xf9 h\u1ee3p trong cu\u1ed9c tr\xf2 chuy\u1ec7n. Tr\xe1nh gi\u1ecdng \u0111i\u1ec7u l\u0103ng m\u1ea1 ho\u1eb7c hung h\u0103ng.","C\xe1c cu\u1ed9c th\u1ea3o lu\u1eadn ho\u1eb7c ho\u1ea1t \u0111\u1ed9ng th\xfac \u0111\u1ea9y h\xe0nh vi b\u1ea5t h\u1ee3p ph\xe1p ho\u1eb7c phi \u0111\u1ea1o \u0111\u1ee9c b\u1ecb c\u1ea5m.","Ng\u01b0\u1eddi d\xf9ng ch\u1ecbu tr\xe1ch nhi\u1ec7m v\u1ec1 n\u1ed9i dung h\u1ecd chia s\u1ebb v\xe0 ph\u1ea3i tu\xe2n th\u1ee7 nguy\xean t\u1eafc c\u1ed9ng \u0111\u1ed3ng.","Ng\u01b0\u1eddi \u0111i\u1ec1u h\xe0nh c\xf3 quy\u1ec1n gi\xe1m s\xe1t v\xe0 th\u1ef1c hi\u1ec7n h\xe0nh \u0111\u1ed9ng \u0111\u1ed1i v\u1edbi b\u1ea5t k\u1ef3 vi ph\u1ea1m n\xe0o, bao g\u1ed3m c\u1ea3nh b\xe1o ho\u1eb7c c\u1ea5m.","N\u1ed9i dung ph\u1ea3i ph\xf9 h\u1ee3p v\u1edbi t\u1ea5t c\u1ea3 c\xe1c nh\xf3m tu\u1ed5i \u0111\u01b0\u1ee3c ph\xea duy\u1ec7t, tu\xe2n theo y\xeau c\u1ea7u v\u1ec1 \u0111\u1ed9 tu\u1ed5i c\u1ee7a \u1ee9ng d\u1ee5ng.","Kh\xf4ng chia s\u1ebb li\xean k\u1ebft \u0111\u1ebfn c\xe1c trang web \u0111\u1ed9c h\u1ea1i, ph\u1ea7n m\u1ec1m \u0111\u1ed9c h\u1ea1i ho\u1eb7c n\u1ed9i dung \u0111\u1ed9c h\u1ea1i.","B\u1eb1ng c\xe1ch s\u1eed d\u1ee5ng t\xednh n\u0103ng tr\xf2 chuy\u1ec7n, b\u1ea1n \u0111\u1ed3ng \xfd v\u1edbi \u0110i\u1ec1u kho\u1ea3n d\u1ecbch v\u1ee5 v\xe0 Ch\xednh s\xe1ch quy\u1ec1n ri\xeang t\u01b0 c\u1ee7a \u1ee9ng d\u1ee5ng. https://bloxfruitscalc.com/privacy-policy/"],e.rulesid=["Selalu berkomunikasi dengan hormat. Ujaran kebencian, diskriminasi, dan pelecehan dilarang keras.","Hindari berbagi konten yang menyinggung, eksplisit, atau tidak pantas, termasuk teks, gambar, atau tautan.","Jangan bagikan informasi pribadi, sensitif, atau rahasia seperti nomor telepon, alamat, atau data keuangan.","Spam, pengiriman pesan berulang, atau promosi produk/jasa tanpa izin tidak diperbolehkan.","Jika Anda menemukan perilaku yang tidak pantas, gunakan alat laporan atau pemblokiran yang tersedia di aplikasi.","Gunakan bahasa yang sesuai dalam obrolan. Hindari nada kasar atau agresif.","Diskusi atau aktivitas yang mendorong perilaku ilegal atau tidak etis dilarang.","Pengguna bertanggung jawab atas konten yang mereka bagikan dan harus mematuhi pedoman komunitas.","Moderator berhak untuk memantau dan mengambil tindakan terhadap pelanggaran, termasuk peringatan atau larangan.","Konten harus sesuai untuk semua kelompok umur yang disetujui, sesuai dengan persyaratan usia aplikasi.","Jangan bagikan tautan ke situs berbahaya, malware, atau konten berbahaya.","Dengan menggunakan fitur obrolan, Anda menyetujui Ketentuan Layanan dan Kebijakan Privasi aplikasi. https://bloxfruitscalc.com/privacy-policy/"],e.rulesfr=["Communiquez toujours avec respect. Les discours de haine, la discrimination et le harc\xe8lement sont strictement interdits.","\xc9vitez de partager du contenu offensant, explicite ou inappropri\xe9, y compris du texte, des images ou des liens.","Ne partagez pas d\u2019informations personnelles, sensibles ou confidentielles telles que des num\xe9ros de t\xe9l\xe9phone, des adresses ou des donn\xe9es financi\xe8res.","Le spam, l\u2019envoi r\xe9p\xe9t\xe9 de messages ou la promotion de produits/services sans autorisation ne sont pas autoris\xe9s.","Si vous observez un comportement inappropri\xe9, utilisez les outils de signalement ou de blocage disponibles dans l\u2019application.","Utilisez un langage appropri\xe9 dans le chat. \xc9vitez les tons insultants ou agressifs.","Les discussions ou activit\xe9s encourageant des comportements ill\xe9gaux ou contraires \xe0 l\u2019\xe9thique sont interdites.","Les utilisateurs sont responsables du contenu qu\u2019ils partagent et doivent respecter les r\xe8gles de la communaut\xe9.","Les mod\xe9rateurs se r\xe9servent le droit de surveiller et de prendre des mesures contre toute violation, y compris des avertissements ou des interdictions.","Le contenu doit \xeatre adapt\xe9 \xe0 tous les groupes d\u2019\xe2ge approuv\xe9s, conform\xe9ment aux exigences d\u2019\xe2ge de l\u2019application.","Ne partagez pas de liens vers des sites nuisibles, des logiciels malveillants ou du contenu malveillant.","En utilisant la fonction de chat, vous acceptez les Conditions d\u2019utilisation et la Politique de confidentialit\xe9 de l\u2019application. https://bloxfruitscalc.com/privacy-policy/"],e.rulesfil=["Laging makipag-usap nang may paggalang. Ang mapoot na pananalita, diskriminasyon, at pananakot ay mahigpit na ipinagbabawal.","Iwasan ang pagbabahagi ng nakakasakit, malaswa, o hindi angkop na nilalaman, kabilang ang teksto, larawan, o mga link.","Huwag ibahagi ang personal, sensitibo, o kumpidensyal na impormasyon tulad ng mga numero ng telepono, address, o data sa pananalapi.","Ang spam, paulit-ulit na pagpapadala ng mensahe, o promosyon ng produkto/serbisyo nang walang pahintulot ay hindi pinapayagan.","Kung makakita ka ng hindi naaangkop na pag-uugali, gamitin ang tool sa pag-uulat o pag-block sa app.","Gumamit ng angkop na wika sa chat. Iwasan ang bastos o agresibong tono.","Ipinagbabawal ang mga talakayan o aktibidad na nagtataguyod ng ilegal o hindi etikal na pag-uugali.","Ang mga gumagamit ay may pananagutan sa nilalaman na kanilang ibinabahagi at dapat sumunod sa mga patakaran ng komunidad.","Ang mga moderator ay may karapatang subaybayan at gumawa ng aksyon laban sa anumang paglabag, kabilang ang mga babala o pagbabawal.","Ang nilalaman ay dapat na angkop para sa lahat ng pinapayagang pangkat ng edad, alinsunod sa mga kinakailangan sa edad ng app.","Huwag magbahagi ng mga link sa nakakapinsalang mga site, malware, o mapanirang nilalaman.","Sa paggamit ng tampok na chat, sumasang-ayon ka sa Mga Tuntunin ng Serbisyo at Patakaran sa Privacy ng app. https://bloxfruitscalc.com/privacy-policy/"],e.rulesru=["\u0412\u0441\u0435\u0433\u0434\u0430 \u043e\u0431\u0449\u0430\u0439\u0442\u0435\u0441\u044c \u0443\u0432\u0430\u0436\u0438\u0442\u0435\u043b\u044c\u043d\u043e. \u0420\u0435\u0447\u0438 \u043d\u0435\u043d\u0430\u0432\u0438\u0441\u0442\u0438, \u0434\u0438\u0441\u043a\u0440\u0438\u043c\u0438\u043d\u0430\u0446\u0438\u044f \u0438 \u043f\u0440\u0435\u0441\u043b\u0435\u0434\u043e\u0432\u0430\u043d\u0438\u0435 \u0441\u0442\u0440\u043e\u0433\u043e \u0437\u0430\u043f\u0440\u0435\u0449\u0435\u043d\u044b.","\u0418\u0437\u0431\u0435\u0433\u0430\u0439\u0442\u0435 \u0440\u0430\u0441\u043f\u0440\u043e\u0441\u0442\u0440\u0430\u043d\u0435\u043d\u0438\u044f \u043e\u0441\u043a\u043e\u0440\u0431\u0438\u0442\u0435\u043b\u044c\u043d\u043e\u0433\u043e, \u043d\u0435\u043f\u0440\u0438\u0441\u0442\u043e\u0439\u043d\u043e\u0433\u043e \u0438\u043b\u0438 \u043d\u0435\u0443\u043c\u0435\u0441\u0442\u043d\u043e\u0433\u043e \u043a\u043e\u043d\u0442\u0435\u043d\u0442\u0430, \u0432\u043a\u043b\u044e\u0447\u0430\u044f \u0442\u0435\u043a\u0441\u0442, \u0438\u0437\u043e\u0431\u0440\u0430\u0436\u0435\u043d\u0438\u044f \u0438\u043b\u0438 \u0441\u0441\u044b\u043b\u043a\u0438.","\u041d\u0435 \u0434\u0435\u043b\u0438\u0442\u0435\u0441\u044c \u043b\u0438\u0447\u043d\u043e\u0439, \u043a\u043e\u043d\u0444\u0438\u0434\u0435\u043d\u0446\u0438\u0430\u043b\u044c\u043d\u043e\u0439 \u0438\u043b\u0438 \u0447\u0443\u0432\u0441\u0442\u0432\u0438\u0442\u0435\u043b\u044c\u043d\u043e\u0439 \u0438\u043d\u0444\u043e\u0440\u043c\u0430\u0446\u0438\u0435\u0439, \u0442\u0430\u043a\u043e\u0439 \u043a\u0430\u043a \u043d\u043e\u043c\u0435\u0440\u0430 \u0442\u0435\u043b\u0435\u0444\u043e\u043d\u043e\u0432, \u0430\u0434\u0440\u0435\u0441\u0430 \u0438\u043b\u0438 \u0444\u0438\u043d\u0430\u043d\u0441\u043e\u0432\u044b\u0435 \u0434\u0430\u043d\u043d\u044b\u0435.","\u0421\u043f\u0430\u043c, \u043f\u043e\u0432\u0442\u043e\u0440\u044f\u044e\u0449\u0438\u0435\u0441\u044f \u0441\u043e\u043e\u0431\u0449\u0435\u043d\u0438\u044f \u0438\u043b\u0438 \u0440\u0435\u043a\u043b\u0430\u043c\u0430 \u0442\u043e\u0432\u0430\u0440\u043e\u0432/\u0443\u0441\u043b\u0443\u0433 \u0431\u0435\u0437 \u0440\u0430\u0437\u0440\u0435\u0448\u0435\u043d\u0438\u044f \u0437\u0430\u043f\u0440\u0435\u0449\u0435\u043d\u044b.","\u0415\u0441\u043b\u0438 \u0432\u044b \u0437\u0430\u043c\u0435\u0442\u0438\u043b\u0438 \u043d\u0435\u043f\u043e\u0434\u043e\u0431\u0430\u044e\u0449\u0435\u0435 \u043f\u043e\u0432\u0435\u0434\u0435\u043d\u0438\u0435, \u0438\u0441\u043f\u043e\u043b\u044c\u0437\u0443\u0439\u0442\u0435 \u0438\u043d\u0441\u0442\u0440\u0443\u043c\u0435\u043d\u0442\u044b \u0436\u0430\u043b\u043e\u0431 \u0438\u043b\u0438 \u0431\u043b\u043e\u043a\u0438\u0440\u043e\u0432\u043a\u0438 \u0432 \u043f\u0440\u0438\u043b\u043e\u0436\u0435\u043d\u0438\u0438.","\u0418\u0441\u043f\u043e\u043b\u044c\u0437\u0443\u0439\u0442\u0435 \u0441\u043e\u043e\u0442\u0432\u0435\u0442\u0441\u0442\u0432\u0443\u044e\u0449\u0438\u0439 \u044f\u0437\u044b\u043a \u0432 \u0447\u0430\u0442\u0435. \u0418\u0437\u0431\u0435\u0433\u0430\u0439\u0442\u0435 \u043e\u0441\u043a\u043e\u0440\u0431\u0438\u0442\u0435\u043b\u044c\u043d\u043e\u0433\u043e \u0438\u043b\u0438 \u0430\u0433\u0440\u0435\u0441\u0441\u0438\u0432\u043d\u043e\u0433\u043e \u0442\u043e\u043d\u0430.","\u0417\u0430\u043f\u0440\u0435\u0449\u0435\u043d\u044b \u043e\u0431\u0441\u0443\u0436\u0434\u0435\u043d\u0438\u044f \u0438\u043b\u0438 \u0434\u0435\u0439\u0441\u0442\u0432\u0438\u044f, \u043f\u0440\u043e\u0434\u0432\u0438\u0433\u0430\u044e\u0449\u0438\u0435 \u043d\u0435\u0437\u0430\u043a\u043e\u043d\u043d\u043e\u0435 \u0438\u043b\u0438 \u043d\u0435\u044d\u0442\u0438\u0447\u043d\u043e\u0435 \u043f\u043e\u0432\u0435\u0434\u0435\u043d\u0438\u0435.","\u041f\u043e\u043b\u044c\u0437\u043e\u0432\u0430\u0442\u0435\u043b\u0438 \u043d\u0435\u0441\u0443\u0442 \u043e\u0442\u0432\u0435\u0442\u0441\u0442\u0432\u0435\u043d\u043d\u043e\u0441\u0442\u044c \u0437\u0430 \u043f\u0443\u0431\u043b\u0438\u043a\u0443\u0435\u043c\u044b\u0439 \u043a\u043e\u043d\u0442\u0435\u043d\u0442 \u0438 \u0434\u043e\u043b\u0436\u043d\u044b \u0441\u043e\u0431\u043b\u044e\u0434\u0430\u0442\u044c \u043f\u0440\u0430\u0432\u0438\u043b\u0430 \u0441\u043e\u043e\u0431\u0449\u0435\u0441\u0442\u0432\u0430.","\u041c\u043e\u0434\u0435\u0440\u0430\u0442\u043e\u0440\u044b \u0438\u043c\u0435\u044e\u0442 \u043f\u0440\u0430\u0432\u043e \u043a\u043e\u043d\u0442\u0440\u043e\u043b\u0438\u0440\u043e\u0432\u0430\u0442\u044c \u0438 \u043f\u0440\u0438\u043c\u0435\u043d\u044f\u0442\u044c \u043c\u0435\u0440\u044b \u043f\u0440\u043e\u0442\u0438\u0432 \u043d\u0430\u0440\u0443\u0448\u0435\u043d\u0438\u0439, \u0432\u043a\u043b\u044e\u0447\u0430\u044f \u043f\u0440\u0435\u0434\u0443\u043f\u0440\u0435\u0436\u0434\u0435\u043d\u0438\u044f \u0438\u043b\u0438 \u0431\u043b\u043e\u043a\u0438\u0440\u043e\u0432\u043a\u0438.","\u041a\u043e\u043d\u0442\u0435\u043d\u0442 \u0434\u043e\u043b\u0436\u0435\u043d \u0431\u044b\u0442\u044c \u043f\u043e\u0434\u0445\u043e\u0434\u044f\u0449\u0438\u043c \u0434\u043b\u044f \u0432\u0441\u0435\u0445 \u043e\u0434\u043e\u0431\u0440\u0435\u043d\u043d\u044b\u0445 \u0432\u043e\u0437\u0440\u0430\u0441\u0442\u043d\u044b\u0445 \u0433\u0440\u0443\u043f\u043f, \u0441\u043e\u043e\u0442\u0432\u0435\u0442\u0441\u0442\u0432\u0443\u044f \u0442\u0440\u0435\u0431\u043e\u0432\u0430\u043d\u0438\u044f\u043c \u043f\u0440\u0438\u043b\u043e\u0436\u0435\u043d\u0438\u044f \u043f\u043e \u0432\u043e\u0437\u0440\u0430\u0441\u0442\u0443.","\u041d\u0435 \u0434\u0435\u043b\u0438\u0442\u0435\u0441\u044c \u0441\u0441\u044b\u043b\u043a\u0430\u043c\u0438 \u043d\u0430 \u0432\u0440\u0435\u0434\u043e\u043d\u043e\u0441\u043d\u044b\u0435 \u0441\u0430\u0439\u0442\u044b, \u0432\u0440\u0435\u0434\u043e\u043d\u043e\u0441\u043d\u043e\u0435 \u041f\u041e \u0438\u043b\u0438 \u0432\u0440\u0435\u0434\u043e\u043d\u043e\u0441\u043d\u044b\u0439 \u043a\u043e\u043d\u0442\u0435\u043d\u0442.","\u0418\u0441\u043f\u043e\u043b\u044c\u0437\u0443\u044f \u0447\u0430\u0442, \u0432\u044b \u0441\u043e\u0433\u043b\u0430\u0448\u0430\u0435\u0442\u0435\u0441\u044c \u0441 \u0423\u0441\u043b\u043e\u0432\u0438\u044f\u043c\u0438 \u0438\u0441\u043f\u043e\u043b\u044c\u0437\u043e\u0432\u0430\u043d\u0438\u044f \u0438 \u041f\u043e\u043b\u0438\u0442\u0438\u043a\u043e\u0439 \u043a\u043e\u043d\u0444\u0438\u0434\u0435\u043d\u0446\u0438\u0430\u043b\u044c\u043d\u043e\u0441\u0442\u0438 \u043f\u0440\u0438\u043b\u043e\u0436\u0435\u043d\u0438\u044f. https://bloxfruitscalc.com/privacy-policy/"],e.rulespt=["Comunique-se sempre com respeito. Discursos de \xf3dio, discrimina\xe7\xe3o e ass\xe9dio s\xe3o estritamente proibidos.","Evite compartilhar conte\xfado ofensivo, expl\xedcito ou inapropriado, incluindo texto, imagens ou links.","N\xe3o compartilhe informa\xe7\xf5es pessoais, sens\xedveis ou confidenciais, como n\xfameros de telefone, endere\xe7os ou dados financeiros.","Spam, envio repetitivo de mensagens ou promo\xe7\xe3o de produtos/servi\xe7os sem permiss\xe3o n\xe3o s\xe3o permitidos.","Se encontrar um comportamento inadequado, utilize as ferramentas de den\xfancia ou bloqueio dispon\xedveis no aplicativo.","Use uma linguagem apropriada no chat. Evite tons ofensivos ou agressivos.","Discuss\xf5es ou atividades que promovam comportamentos ilegais ou anti\xe9ticos s\xe3o proibidas.","Os usu\xe1rios s\xe3o respons\xe1veis pelo conte\xfado que compartilham e devem seguir as diretrizes da comunida